<style type="text/css">
	.keyword{
    height: 0;
    max-height: 0;
    overflow: hidden;
}

.pageIndex{max-width:100%; padding:0;}
.main_part{max-width:2000px; padding:0; margin:0 auto;}
.edit, .edit_part, .show_content, .main_part{width:100%; max-width: 100%; padding:0;}

.box_container {width:100%; max-width:2000px; font-family:"微軟正黑體",Microsoft JhengHei; font-size:var(--font18); letter-spacing: 2px; color:#666666; border:0; text-decoration:none; overflow:hidden; margin: auto;}
.box_container img{width:auto; max-width:100%;}
.box_container * {box-sizing: border-box; max-width:100%;  padding:0; margin:0; line-height:150%;}
.box_container a{text-decoration:none;}
.box_container ul{list-style:none;}
.box_container i, .box_container em, .box_container dfn, .box_container var{font-style: normal;line-height: 0px;}
.box_container u{text-decoration:none;}

/*Animations*/
[data-animate-in] { opacity: 0; transition: transform 0.8s ease, opacity 0.8s ease;}
[data-animate-in="up"] { transform: translate3d(0, 20%, 0);}/*由下往上*/
[data-animate-in="left"] { transform: translate3d(-30%, 0, 0);}/*由左往右*/
[data-animate-in="right"] { transform: translate3d(30%, 0, 0);}/*由右往左*/
[data-animate-in="down"] { transform: translate3d(0, -20%, 0);}/*由上往下*/
[data-animate-in="fadeIn"] { transform: translate3d(0, 0, 0);}/*淡入*/
[data-animate-in="scaleIn"] {transform: scale(.3);}/*放大淡入*/
[data-animate-in].in-view { opacity: 1; transform:translate3d(0,0,0); -webkit-transform:translate3d(0,0,0); transition: transform 1.2s ease, opacity 1s ease;}
.fade-in { opacity: 0; transition: opacity 1s ease; }

@keyframes play{
	0%{background-position: 0 0;}
	100%{background-position: 0 303px;}
}
@keyframes updown{
	50%{ transform:translate(-50%,20px);}
	0%,
	100%{ transform:translate(-50%,0);}
}

	.content_flex{
        display: flex;
		justify-content: space-between;
        align-items: center;
    }
	.box_container{
		--font20: 20px;
		--font18: 18px;
		--font16: 16px;
	}
	.box_container h5{
		display: flex;
		justify-content: flex-start;
		align-items: flex-end;
		font-size: var(--font18);
	}
	.box_container h5 img{
		display: block;
	}
	.box_container h5 b{
		display: block;
		padding: 3px 25px 3px 10px;
		color: #222225;
		word-break: keep-all;
		position: relative;
	}
	.box_container h5 b:before{
		content: '';
		border-bottom: 1px solid #888888;
		width: calc(100% + 10px);
		position: absolute;
		left: -10px;
		bottom: 0;
	}
	.box_container h5 b:after{
		content: '';
		background: #888888;
		width: 17px;
		height: 3px;
		position: absolute;
		right: 0;
		bottom: 0;
	}

	.abg01{
		background: url(https://pic03.eapple.com.tw/hardcorepdr/abg_01.jpg) no-repeat center;
		background-size: cover;
		margin-top: 30px;
	}
	.abg01_1{
		width: 97%;
		max-width: 1784px;
		margin-left: auto;
	}
	.abg01_1 dt{
		width: 615px;
		padding: 3% 0;
		margin-right: 3%;
	}
	.abg01_1 dt p{
		margin: 40px 0 15px;
	}
	.abg01_1 dd{
		line-height: 0;
		position: relative;
		top: -30px;
		margin-bottom: -30px;
		align-self: stretch;
		display: flex;
		justify-content: center;
		align-items: flex-end;
	}
	.abg01_2{
		width: 97%;
		max-width: 1800px;
	}
	.abg01_2 dd{
		align-self: stretch;
	}
	.abg01_2 dd img{
		object-fit: cover;
		object-position: right;
		min-height: 100%;
	}
	.abg01_2 dt{
		width: calc(615px + 5%);
		padding: 3% 5% 3% 0;
		margin-left: 3%;
		position: relative;
	}
	.abg01_2 dt h6{
		font-size: var(--font20);
		font-style: italic;
	}
	.abg01_2 dt h6 b{
		display: block;
		width: fit-content;
		margin: 15px 0 0 auto;
	}
	.abg01_2 dt p{
		margin: 40px 0 15px;
	}
	.abg01_2 dt i{
		background: url(https://pic03.eapple.com.tw/hardcorepdr/abo_04.png) repeat-y center;
		background-size: cover;
		position: absolute;
		right: 0;
		bottom: -3%;
		width: 31px;
		height: 202px;
		-webkit-animation: play 10s steps(12) infinite alternate;
		animation: play 10s steps(15000) infinite;
	}
	.abg01_3{
		width: 97%;
		max-width: 1750px;
		margin: 90px 0 0 auto;
	}
	.abg01_3 dt{
		width: 654px;
		padding-bottom: 3%;
		margin-right: 3%;
	}
	.abg01_3 dt h5 b{
		margin-bottom: 5px;
	}
	.abg01_3 dd{
		max-width: 972px;
		position: relative;
		line-height: 0;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		align-self: stretch;
	}
	.abg01_3 dd i{
		width: 59.5%;
		position: absolute;
		top: 10%;
		left: 45%;
		animation: updown 3s ease-out infinite;
	}
	.accordion{
		border-top: none;
		margin-top: 40px;
	}
	.accordion a{
		border-bottom: 1px solid #AAAAAA;
	}
	.accordion a.click_btn_a {
		display: block;
		cursor: pointer;
	}
	.accordion a.click_btn_a section{
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 15px 5px 15px 33px;
		color: #000000;
		transition: 0.4s;
		font-size: var(--font20);
		position: relative;
	}
	.accordion a.click_btn_a section:before{
		content: 'Q';
		font-size: var(--font16);
		display: flex;
		justify-content: center;
		align-items: center;
		width: 21px;
		height: 21px;
		background: #000000;
		color: #fff;
		border-radius: 100%;
		font-family: 'Archivo Black', sans-serif;
		position: absolute;
		left: 0;
		top: 18px;
	}
	.accordion a:hover.click_btn_a section,
	.accordion a.active.click_btn_a section{
		transition: 0.4s;
	}
	.accordion a.click_btn_a section:after{
		content: '+';
		font-size: 25px;
		margin-left: 5px;
	}
	.accordion a.active.click_btn_a section:after{
		content: '-';
		font-size: 30px;
	}
	.qa_a{
		padding: 0 5px 20px 33px;
		color: #666666;
		display: none;
		position: relative;
	}
	.qa_a:after{
		content: 'A';
		font-size: var(--font16);
		display: flex;
		justify-content: center;
		align-items: center;
		width: 21px;
		height: 21px;
		color: #000;
		border-radius: 100%;
		border: 1px solid #000;
		font-family: 'Archivo Black', sans-serif;
		position: absolute;
		left: 0;
		top: 3px;
	}
	.qa_a p{
		margin-bottom: 15px;
	}
	.abg02{
		background: url(https://pic03.eapple.com.tw/hardcorepdr/abg_02.jpg) no-repeat center;
		background-size: cover;
		padding: 90px 3%;
	}
	.abg02_1{
		max-width: 1820px;
		margin: auto;
	}
	.abg02_1 dt{
		width: 614px;
		margin-right: 3%;
	}
	.abg02_1 dt figure{
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 15%;
	}
	.abg02_1 dt figure:before{
		content: '';
		background: #AAAAAA;
		width: 80%;
		height: 1px;
		margin-right: 5px;
	}
	.abg02_1 dt figure a{
		min-width: 49px;
		height: 50px;
		border-radius: 100%;
		background: #000;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-left: 15px;
	}
	.abg02_1 dt figure a img{
		display: block;
		transition: .4s;
	}
	.abg02_1 dt figure a:hover{
		background: #333;
	}
	.abg02_1 dt figure a:hover img{
		transform: rotateY(360deg);
	}
	.abg02_1 dd{
		display: flex;
		justify-content: space-between;
		align-items: stretch;
	}
	.abg02_1 dd img{
		width: calc(100%/2 - 5px);
		max-width: 558px;
	}


@media screen and (max-width:1000px) {
	.abg01_1,
	.abg01_3,
	.abg02_1{width: 100%; flex-wrap: wrap; justify-content: center;}
	.abg01_1 dt,
	.abg01_2 dt{padding: 70px 5%; margin: auto;}
	.abg01_1 dd{padding-left: 3%;}
	.abg01_2{width: 100%; flex-wrap: wrap-reverse; justify-content: center;}
	.abg01_2 dd{padding-right: 3%;}
	.abg01_3 dt{width: 800px; padding: 0 5% 70px; margin: auto;}
	.abg01_3 dd{width: 90%;}
	.abg02_1 dt{padding: 0 0 50px; margin: 0 auto;}
}

@media screen and (max-width:768px) {
	.abg01 { margin-top: 0;}
	.abg01_1 dd{padding-left: 5%;}
	.abg01_2 dd{padding-right: 5%;}
	.abg02{padding: 70px 5%;}
}

@media screen and (max-width:480px) {
	.box_container{
		--font20: 18px;
		--font18: 17px;
	}
	.abg01_1 dt,
	.abg01_2 dt{padding: 50px 5% 60px;}
	.abg01_2 dt i{width: 5vw; bottom: unset; top: 95%; right: 10px; background-size: contain; height: 100px;}
	.abg01_3{margin-top: 50px;}
	.abg01_3 dt{padding: 0 5% 50px;}
	.abg02{padding: 50px 5%;}
	.abg02_1 dt figure a{min-width: 45px; height: 45px; padding: 10px;}
	.abg02_1 dd{flex-wrap: wrap;}
	.abg02_1 dd img{width: 100%; margin-top: 10px;}
}

