<script>
    (function($) {
        $('.accordion > li:eq(0) a.click_btn_a').addClass('active').next().slideDown(); //預設第一個開啟
        $('.accordion .click_btn_a').click(function(j) {
            var dropDown = $(this).closest('li').find('.qa_a');
    
            $(this).closest('.accordion').find('.qa_a').not(dropDown).slideUp();
    
            if ($(this).hasClass('active')) {
                $(this).removeClass('active');
            } else {
                $(this).closest('.accordion').find('.click_btn_a.active').removeClass('active');
                $(this).addClass('active');
            }
    
            dropDown.stop(false, true).slideToggle();
    
            j.preventDefault();
        });
    })(jQuery);
</script>            <!-- 編輯器結束 -->
